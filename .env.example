# Copia este fichero como .env y cambia las contraseñas:  cp .env.example .env

# ── Base de datos (MySQL) ─────────────────────────────
# La imagen de MySQL usa estas variables para crear la BD y el usuario
# la primera vez que arranca (volumen vacío). docker-compose.yml se las
# pasa también a PHP como DB_*.
MYSQL_ROOT_PASSWORD=cambia_esta_root
MYSQL_DATABASE=piloto_cms
MYSQL_USER=piloto
MYSQL_PASSWORD=cambia_esta
MYSQL_HOST=db

# ── App ───────────────────────────────────────────────
# local o development activan CORS para los frontends de Vite
APP_ENV=local
# APP_DEBUG=true   # devuelve el token de recuperación en la respuesta (solo pruebas)
# AUTH_TOKEN_TTL_DAYS=7
# PASSWORD_RESET_TTL_MINUTES=60

# ── Google OAuth ──────────────────────────────────────
# Vacío = el endpoint /api/auth/google responde 503
GOOGLE_CLIENT_ID=
